# Supabase — copy to .env.local for local work, and set the same keys in
# Vercel Project Settings → Environment Variables for deployment.
#
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — SERVER-SIDE ONLY (bypasses RLS). Used for
# reliable credit debits. Found in: Supabase → Project Settings → API →
# service_role secret. NEVER expose to the browser / never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ElevenLabs (voice cloning + TTS). SERVER-SIDE ONLY — must NOT be a
# NEXT_PUBLIC_ var, or the key would be exposed to the browser. Set it in
# Vercel → Project Settings → Environment Variables.
# Found in: ElevenLabs → Profile → API Keys.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# TTS output format. Defaults to mp3_44100_128 (44.1kHz, 128kbps — clean and
# supported on all plans). Set to mp3_44100_192 on Creator+ tiers for 192kbps.
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# OpenRouter (LLM script assist + translation). SERVER-SIDE ONLY.
# Found in: openrouter.ai → Keys. Optionally override the model.
OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Replicate (flux-kontext-pro image editing for wardrobe/background presets).
# SERVER-SIDE ONLY. Found in: replicate.com → Account → API tokens.
REPLICATE_API_TOKEN=your-replicate-api-token
# Optional override / version pin: "owner/name" or "owner/name:version".
# REPLICATE_KONTEXT_MODEL=black-forest-labs/flux-kontext-pro

# WaveSpeedAI (InfiniteTalk lip-sync video). SERVER-SIDE ONLY.
# Found in: wavespeed.ai → Dashboard → API Keys.
WAVESPEED_API_KEY=your-wavespeed-api-key
# Render resolution. Defaults to 720p (~$0.06/sec). Set to 480p to halve cost
# during iteration (~$0.03/sec).
# WAVESPEED_RESOLUTION=720p
